GUGUPAN_PORT=8080
GUGUPAN_ADMIN_USERNAME=admin
# Empty on first boot generates data/initial-admin-password.txt.
# The value is used only when creating the first administrator.
GUGUPAN_ADMIN_PASSWORD=
# Set true when accessed over HTTPS.
COOKIE_SECURE=false
# Required when enabling the optional https profile.
GUGUPAN_DOMAIN=pan.example.com
